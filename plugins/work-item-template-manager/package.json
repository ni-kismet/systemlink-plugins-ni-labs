{
  "name": "work-item-template-manager",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Create, edit, filter, group, and organize SystemLink work item (test plan) templates, including file attachments and dashboard configuration.",
  "homepage": "https://github.com/ni-kismet/systemlink-plugins-ni-labs",
  "scripts": {
    "ng": "ng",
    "start": "dotenv -o -e .env -- ng serve",
    "build": "ng build && npm run postbuild:cspfix",
    "postbuild:cspfix": "node scripts/postbuild-csp-fix.js",
    "clean": "rm -rf dist submission-manifest.json",
    "package": "npm run clean && npm run build && node ../../scripts/build-plugin-package.mjs . && node ../../scripts/verify-plugin-package.mjs .",
    "submission-manifest": "npm run package && node ../../scripts/create-submission-manifest.mjs .",
    "i18n": "ng extract-i18n --format json --output-path src/locale && node scripts/i18n-sync.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "lint:style:fix": "stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\""
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.19",
    "@angular/compiler": "^20.3.19",
    "@angular/core": "^20.3.19",
    "@angular/forms": "^20.3.19",
    "@angular/localize": "^20.3.20",
    "@angular/platform-browser": "^20.3.19",
    "@ni/nimble-angular": "^33.2.0",
    "@ni/nimble-components": "^35.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.25",
    "@angular/cli": "^20.3.19",
    "@angular/compiler-cli": "^20.3.19",
    "@eslint/js": "^9.0.0",
    "@types/jasmine": "^5.1.0",
    "angular-eslint": "20.7.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.8.0",
    "jasmine-core": "^5.1.0",
    "karma": "^6.4.2",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "~5.8.0",
    "typescript-eslint": "8.27.0"
  }
}
