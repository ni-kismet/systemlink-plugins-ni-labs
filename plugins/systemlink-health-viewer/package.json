{
  "name": "systemlink-health-viewer",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "ng serve --open",
    "build": "ng build --configuration production",
    "clean": "rm -rf dist submission-manifest.json",
    "package": "npm run clean && npm run build && node ../../scripts/build-plugin-package.mjs . && node ../../scripts/verify-plugin-package.mjs .",
    "submission-manifest": "npm run package && node ../../scripts/create-submission-manifest.mjs .",
    "test": "ng test --watch=false",
    "test:i18n": "node --test scripts/i18n-sync.test.mjs",
    "i18n": "ng extract-i18n --format json --output-path src/locale && node scripts/i18n-sync.mjs",
    "publish:demo": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-demo.ps1"
  },
  "dependencies": {
    "@angular/animations": "^20.3.34",
    "@angular/common": "^20.3.34",
    "@angular/compiler": "^20.3.34",
    "@angular/core": "^20.3.34",
    "@angular/forms": "^20.3.34",
    "@angular/localize": "^20.3.34",
    "@angular/platform-browser": "^20.3.34",
    "@angular/router": "^20.3.34",
    "@ni/nimble-angular": "^33.6.2",
    "@ni/nimble-components": "^35.17.0",
    "@ni/ok-angular": "^2.7.4",
    "@ni/ok-components": "^1.12.2",
    "@ni/spright-angular": "^9.6.2",
    "@ni/unit-format": "^1.0.9",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.41",
    "@angular/cli": "^20.3.41",
    "@angular/compiler-cli": "^20.3.34",
    "@types/jasmine": "^5.1.0",
    "@types/node": "^24.19.2",
    "jasmine-core": "^5.1.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~5.9.3"
  }
}
